# Salin file ini jadi .env lalu isi nilainya
VITE_SUPABASE_URL=http://192.168.19.111:8000
VITE_SUPABASE_ANON_KEY=isi_dengan_ANON_KEY_dari_.env_supabase
# Domain internal untuk login pakai username: "admin" -> admin@example.com
# (harus sama dengan domain email akun di Supabase Auth)
VITE_LOGIN_DOMAIN=example.com
